      ],
      "id": "fc34f79b-5b4a-481d-882a-93f56a51d117",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        608,
        208
      ],
      "id": "3b2a3611-c5aa-447f-9af6-fb335a254fe7",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item, index) => {\n\n  const original = $('Edit Fields').itemMatching(index).json;\n\n  const recipe = original.recipe;\n  const channelId = original.channel_id;\n\n  // Get AI-generated response\n  let response = item.json.text || '';\n\n  // Clean and format the response\n  response = response\n    .replace(/\\\\n/g, '\\n')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')\n    .replace(/^\\s*-\\s+/gm, '• ')\n    .trim();\n\n  // Prepare Slack message\n  const message =\n    `🍽️ *AI Recipe Assistant*\\n` +\n    `👥 Servings: 4 people\\n\\n` +\n    response +\n    `\\n\\n_Generated by n8n AI Recipe Bot_`;\n\n  return {\n    json: {\n      recipe: recipe,\n      channel_id: channelId,\n      message: message\n    },\n    pairedItem: { item: index }\n  };\n\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
